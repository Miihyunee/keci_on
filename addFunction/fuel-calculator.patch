+ *   유종별 전국 평균 리터당 단가를 조회합니다.
+ * - 특정 지역 선택 시: "지역별 최저가 주유소 TOP20" API(lowTop10.do)로
+ *   해당 지역 최저가 주유소 10곳을 조회한 뒤 평균을 리터당 단가로 사용합니다.
+ *   (공식 오픈 API에는 "지역 평균가격"이 별도로 제공되지 않아, 최저가 TOP10의
+ *   평균으로 지역 시세를 추정합니다. 실제 지역 평균보다 낮게 잡힐 수 있습니다.)
+ * - 예상 유류비 = 이동 거리(km) ÷ 차량 연비(km/L) × 리터당 단가
+ * - 오피넷 API는 브라우저에서 직접 호출할 경우 CORS 정책에 의해 차단될 수
+ *   있습니다. 이 경우 리터당 단가를 직접 입력하면 계산기는 동일하게 동작합니다.
+ * ============================================================ */
+const OPINET_PRODUCTS = {
+    B027: '휘발유',
+    D047: '경유',
+    B034: '고급휘발유',
+    K015: 'LPG(자동차용부탄)'
+};
+
+/**
+ * 오피넷 API 인증키를 여기에 고정해두면 화면에서 별도로 입력할 필요가 없습니다.
+ * 예: const DEFAULT_OPINET_API_KEY = 'a1b2c3d4e5f6...';
+ * ⚠️ 정적 페이지 특성상 이 값은 브라우저에서 페이지 소스를 통해 누구나 볼 수 있습니다.
+ *    저장소가 공개(public) 상태라면 유출될 수 있다는 점을 감안해 주세요.
+ */
+const DEFAULT_OPINET_API_KEY = '';
+
+/**
+ * 실제 사용할 인증키를 결정합니다. (localStorage에 저장된 값이 있으면 우선 사용, 없으면 기본값)
+ */
+function getOpinetApiKey() {
+    const saved = localStorage.getItem('opinetApiKey');
+    if (saved) return saved;
+    return DEFAULT_OPINET_API_KEY.trim();
+}
+
+/**
+ * 유류비 계산기 패널을 열고 닫습니다.
+ */
+function toggleFuelCalc() {
+    const btn = document.getElementById('fuelCalcToggleBtn');
+    if (btn && btn.disabled) return; // 대중교통 선택 시에는 열리지 않음
+
+    const panel = document.getElementById('fuelCalcPanel');
+    if (!panel) return;
+
+    const opening = panel.style.display === 'none' || !panel.style.display;
+    panel.style.display = opening ? 'block' : 'none';
+
+    if (opening) {
+        // 서식 초기화 등으로 연비 값이 비어있으면 기본값(10km/L)을 채워줍니다.
+        const effInput = document.getElementById('fuelEfficiency');
+        if (effInput && !effInput.value) effInput.value = '10';
+
+        updateFuelCalcTripDateNote();
+        updateFuelCalcResult();
+    }
+}
+
+/**
+ * 출장 시작일(dateStart)과 오늘 날짜를 비교해 유류비 계산기 패널에 안내 문구를 표시합니다.
+ * 오피넷 무료 API는 "오늘자" 가격만 제공하므로, 출장일이 오늘이 아니면 조회 값이
+ * 실제 출장 당일 가격과 다를 수 있음을 알려줍니다.
+ */
+function updateFuelCalcTripDateNote() {
+    const noteEl = document.getElementById('fuelTripDateNote');
+    if (!noteEl) return;
+
+    const startEl = document.getElementById('dateStart');
+    const tripDateVal = startEl ? startEl.value : '';
+    if (!tripDateVal) {
+        noteEl.innerHTML = '';
+        return;
+    }
+
+    const todayVal = new Date().toLocaleDateString('en-CA'); // YYYY-MM-DD
+    const tripDate = new Date(tripDateVal + 'T00:00:00');
+    const todayDate = new Date(todayVal + 'T00:00:00');
+    if (isNaN(tripDate.getTime())) {
+        noteEl.innerHTML = '';
+        return;
+    }
+
+    const diffDays = Math.round((todayDate - tripDate) / (1000 * 60 * 60 * 24));
+
+    if (diffDays === 0) {
+        noteEl.innerHTML = `<span style="color:#16a34a;">✓ 출장 시작일(${tripDateVal})이 오늘이라 실시간 조회 값을 그대로 사용할 수 있습니다.</span>`;
+    } else if (diffDays > 0) {
+        noteEl.innerHTML = `<span style="color:#d97706;">⚠️ 출장 시작일(${tripDateVal})은 오늘보다 ${diffDays}일 전입니다. 오피넷 무료 API는 "오늘자" 가격만 제공하므로 조회 값은 참고용입니다. 정확한 정산을 위해 리터당 단가에 출장 당일 실제 가격(영수증 등)을 직접 입력해 주세요.</span>`;
+    } else {
+        noteEl.innerHTML = `<span style="color:#d97706;">⚠️ 출장 시작일(${tripDateVal})은 오늘보다 ${Math.abs(diffDays)}일 후입니다. 조회 값은 오늘 기준가이며 출장 당일 가격과 다를 수 있습니다.</span>`;
+    }
+}
+
+/**
+ * 오피넷 API를 호출하여 선택한 유종·지역의 리터당 단가를 자동으로 채워줍니다.
+ * - 지역이 "전국 평균"이면 avgAllPrice.do(전국 평균가격)를 사용합니다.
+ * - 특정 지역이 선택되어 있으면 lowTop10.do(지역별 최저가 TOP10)의 평균을 사용합니다.
+ */
+async function fetchOpinetPrice() {
+    const statusEl = document.getElementById('fuelApiStatus');
+    const productSelect = document.getElementById('fuelProductCode');
+    const areaSelect = document.getElementById('fuelAreaCode');
+    const key = getOpinetApiKey();
+    const productCode = productSelect ? productSelect.value : 'B027';
+    const areaCode = areaSelect ? areaSelect.value : '';
+
+    if (!key) {
+        alert('오피넷 API 인증키가 설정되어 있지 않습니다. script.js 상단의 DEFAULT_OPINET_API_KEY에 발급받은 인증키를 넣어 주세요.');
+        return;
+    }
+
+    if (statusEl) {
+        statusEl.style.color = '#64748b';
+        statusEl.innerText = '실시간 유가를 조회하는 중입니다...';
+    }
+
+    try {
+        const controller = new AbortController();
+        const timeoutId = setTimeout(() => controller.abort(), 8000);
+
+        let price, label;
+
+        if (!areaCode) {
+            // 전국 평균가격
+            const url = `https://www.opinet.co.kr/api/avgAllPrice.do?out=json&certkey=${encodeURIComponent(key)}`;
+            const res = await fetch(url, { signal: controller.signal });
+            clearTimeout(timeoutId);
+            if (!res.ok) throw new Error(`HTTP ${res.status}`);
+            const data = await res.json();
+
+            const list = data && data.RESULT && data.RESULT.OIL ? data.RESULT.OIL : null;
+            if (!list) throw new Error('응답 형식 오류');
+            const items = Array.isArray(list) ? list : [list];
+            const matched = items.find(item => item.PRODCD === productCode);
+            if (!matched) throw new Error('해당 유종 데이터를 찾을 수 없습니다');
+
+            price = Math.round(parseFloat(matched.PRICE));
+            label = `전국 평균 · 기준일 ${matched.TRADE_DT || '-'}`;
+        } else {
+            // 지역 최저가 TOP10 평균 (지역 평균가 API가 없어 최저가 TOP10 평균으로 추정)
+            const url = `https://www.opinet.co.kr/api/lowTop10.do?out=json&certkey=${encodeURIComponent(key)}&prodcd=${encodeURIComponent(productCode)}&area=${encodeURIComponent(areaCode)}&cnt=10`;
+            const res = await fetch(url, { signal: controller.signal });
+            clearTimeout(timeoutId);
+            if (!res.ok) throw new Error(`HTTP ${res.status}`);
+            const data = await res.json();
+
+            const list = data && data.RESULT && data.RESULT.OIL ? data.RESULT.OIL : null;
+            if (!list) throw new Error('응답 형식 오류');
+            const items = Array.isArray(list) ? list : [list];
+            if (items.length === 0) throw new Error('해당 지역 데이터를 찾을 수 없습니다');
+
+            const sum = items.reduce((acc, item) => acc + (parseFloat(item.PRICE) || 0), 0);
+            price = Math.round(sum / items.length);
+            const areaLabel = areaSelect.options[areaSelect.selectedIndex].text;
+            label = `${areaLabel} 최저가 TOP${items.length} 평균`;
+        }
+
+        const priceInput = document.getElementById('fuelUnitPrice');
+        if (priceInput) priceInput.value = price;
+
+        // 출장 시작일과 오늘 날짜가 다르면 조회 결과가 참고용임을 함께 안내합니다.
+        const startEl = document.getElementById('dateStart');
+        const tripDateVal = startEl ? startEl.value : '';
+        const todayVal = new Date().toLocaleDateString('en-CA');
+        const dateWarning = (tripDateVal && tripDateVal !== todayVal)
+            ? ` — ⚠️ 오늘(${todayVal}) 기준가이며 출장일(${tripDateVal})과 다를 수 있어요`
+            : '';
+
+        if (statusEl) {
+            statusEl.style.color = tripDateVal && tripDateVal !== todayVal ? '#d97706' : '#16a34a';
+            statusEl.innerText = `조회 완료 (${OPINET_PRODUCTS[productCode] || productCode} · ${label}) — ${price.toLocaleString()}원/L${dateWarning}`;
+        }
+
+        updateFuelCalcTripDateNote();
+        updateFuelCalcResult();
+    } catch (err) {
+        // 오피넷 API는 브라우저 직접 호출 시 CORS 정책에 의해 차단될 수 있습니다.
+        if (statusEl) {
+            statusEl.style.color = '#dc2626';
+            statusEl.innerText = '실시간 조회에 실패했습니다 (인증키 오류 또는 브라우저 보안 정책(CORS) 차단일 수 있습니다). 아래 "리터당 단가"에 직접 입력해 계산을 진행해 주세요.';
+        }
+    }
+}
+
+/**
+ * 이동 거리 ÷ 차량 연비 × 리터당 단가로 예상 유류비를 계산하여 화면에 표시합니다.
+ */
+function updateFuelCalcResult() {
+    const resultEl = document.getElementById('fuelCalcResult');
+    if (!resultEl) return 0;
+
+    const unitPrice = parseInt((document.getElementById('fuelUnitPrice') || {}).value || '0', 10) || 0;
+    const distance = parseInt((document.getElementById('fuelDistance') || {}).value || '0', 10) || 0;
+    const efficiency = parseFloat((document.getElementById('fuelEfficiency') || {}).value || '0') || 0;
+
+    const cost = efficiency > 0 ? Math.round((distance / efficiency) * unitPrice) : 0;
+    resultEl.innerText = `${cost.toLocaleString()}원`;
+    return cost;
+}
+
+/**
+ * 계산된 예상 유류비를 업무 주유 정산비(개인/법인) 입력값에 더해 반영합니다.
+ */
+function applyFuelCost(type) {
+    const vehicleEl = document.getElementById('vehicle');
+    if (vehicleEl && vehicleEl.value === 'public') {
+        alert('대중교통 이용 시에는 주유 정산비를 반영할 수 없습니다. 지원 이동차량 구분을 확인해 주세요.');
+        return;
+    }
+
+    const cost = updateFuelCalcResult();
+    if (!cost || cost <= 0) {
+        alert('반영할 유류비가 0원입니다. 리터당 단가, 이동 거리, 연비를 확인해 주세요.');
+        return;
+    }
+
+    const targetEl = document.getElementById(`transportFuel${type}`);
+    if (!targetEl) return;
+
+    const current = parseInt(targetEl.value.replace(/[^0-9]/g, '') || '0', 10) || 0;
+    targetEl.value = current + cost;
+
+    const statusEl = document.getElementById('fuelApiStatus');
+    if (statusEl) {
+        statusEl.style.color = '#16a34a';
+        statusEl.innerText = `${type === 'Personal' ? '개인' : '법인'} 정산비에 ${cost.toLocaleString()}원이 반영되었습니다.`;
     }
 
     updatePreview();
